# Flask Application Configuration
FLASK_ENV=development
FLASK_APP=backend.app:create_app
SECRET_KEY=replace-with-a-long-random-secret-key-64-hex
JWT_SECRET_KEY=replace-with-another-long-random-secret-key-64-hex

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/skin_lesion_ai
BCRYPT_ROUNDS=12

# ML Inference Configuration
MODEL_PATH=ml/checkpoints/efficientnet_b0/best_model.pt
DEVICE=cuda
MIXED_PRECISION=true

# Storage Configuration
UPLOAD_DIR=storage/uploads
GRADCAM_DIR=storage/gradcam
MAX_UPLOAD_MB=10
